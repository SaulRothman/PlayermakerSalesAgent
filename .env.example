# Copy to .env locally. Never commit real keys.
PORT=3001
CATALOG_DATA_DIR=data/playermaker
CATALOG_API_URL=http://localhost:3001
# Optional. When set, all API routes require X-API-Key or Authorization: Bearer.
# CATALOG_API_KEY=

# Phase 4 — lead pipeline. When DEVREV_PAT is set, POST /v1/leads creates a
# DevRev account + contact (and a ticket if DEVREV_PART_ID is set).
# Leave unset to persist locally in data/playermaker/leads.json (gitignored).
# DEVREV_PAT=
# DEVREV_API_BASE=https://api.devrev.ai
# DEVREV_REV_ORG=
# DEVREV_PART_ID=

# Phase 6 prerequisite — DevRev cloud cannot reach localhost.
# Point skills 220–223 at a public HTTPS URL of this API (staging or ngrok/cloudflared).
# CATALOG_PUBLIC_URL=
